# Version control and GitHub
.git
.github
.gitignore
.editorconfig

# Docs, tests, developer tools and the Unraid/CasaOS templates (not part of the running app)
docs
deploy
test
test-setup.js
tools
# … except the emergency tool for forgotten admin PINs (command line, see docs/operations)
!tools/reset-pin.php
node_modules
scratch
package.json
*.md

# Runtime and developer data stay out: the container deliberately starts with an
# empty instance (initial setup wizard, demo data can be loaded there); data/.htaccess
# comes along. (The developer seeds live under tools/, which stays out anyway.)
data/*.json
data/users
data/family
data/auth

# Docker self-reference
docker-compose.yml
.dockerignore
