# macOS
.DS_Store

# Temporary files of the PHP persistence layer's atomic writes
data/.tmp_*

# Runtime data storage. In the repo, data/ holds only the access protection (.htaccess);
# the developer seeds have lived in tools/seed/ since v3.20.0 (a fresh
# installation starts with the initial setup).
data/users/
data/family/
data/auth/
data/.bootstrap.lock
data/*.json

# Open Food Facts nutrition cache (runtime, machine-specific)
data/foodfacts.json
data/foodfacts.json.lock

# Local developer tools and working directories (machine-specific)
.playwright-mcp/
scratch/
graphify-out/
.understand-anything/
.claude/
*.log

# Static demo build (tools/build-demo.mjs)
dist/
