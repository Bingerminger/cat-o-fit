# Cat-O-Fit – server notes for the static app shell.
#
# IMPORTANT: the browser only runs ES modules (<script type="module">) if the
# server delivers the .js files with a JavaScript MIME type. If the server sends
# them as text/plain or application/octet-stream, the page stays blank. These
# rules make sure the correct type is sent.
#
# Synology Web Station with the Apache back end evaluates this file. With the
# Nginx back end it is ignored – Nginx serves .js correctly by default; if it
# does not, set the MIME type "js -> text/javascript" in the Web Station profile.

<IfModule mod_mime.c>
  AddType text/javascript            .js .mjs
  AddType application/json           .json
  AddType application/manifest+json  .webmanifest
  AddType image/svg+xml              .svg
</IfModule>

# Compression: the shell (around 830 KB of JavaScript, no build step) goes over the
# wire at roughly 280 KB gzipped – noticeable on the move, over VPN/LTE to the home server.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Never cache the app shell hard: the browser may store it but MUST revalidate
# before use (answers 304 if unchanged). This way new releases arrive immediately –
# even in a normal tab WITHOUT a service worker (previously js/css were cached
# heuristically and kept showing the old version after a release).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|mjs|css|webmanifest|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers: no embedding in foreign pages (clickjacking), no referrer
  # sent to third parties, no device APIs, only own scripts/styles. The only
  # connection from the browser to the outside is the (switchable) Open-Meteo weather query.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  # Camera for the own page only: for scanning barcodes (nutrition). The browser
  # still asks for permission every time; embedded foreign pages never get it.
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Serve the app only: developer, documentation and repo files cannot be fetched
# (important with Web Station/git checkout; tools/, test/ and docs/ additionally
# carry their own .htaccess). Nginx does not evaluate this file – see the
# installation guide (docs/operations/installation.md), section "Running outside
# your home network".
<FilesMatch "^(\..*|package\.json|package-lock\.json|test-setup\.js|Dockerfile|docker-compose\.yml|[A-Z_]+\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(git|github|claude|understand-anything|playwright-mcp)(/|$)" - [F]
  RewriteRule "^(docker|scratch|graphify-out|node_modules)(/|$)" - [F]
</IfModule>
